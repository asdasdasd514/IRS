PROJECT_NAME="IRS Mobile Admissions Platform API"
ENV=production
PORT=8000

# MongoDB Configuration (MongoDB Atlas Cloud)
MONGODB_URL="mongodb+srv://<username>:<password>@cluster0.gh3py9s.mongodb.net/?appName=Cluster0"
DATABASE_NAME="IRS"

# JWT Security
SECRET_KEY="your-production-secret-key"
JWT_SECRET_KEY="your-production-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# External APIs (Optional)
SERPAPI_KEY=""
GOOGLE_MAPS_API_KEY=""

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_URL=""

# CORS Origin (Thêm URL frontend Vercel vào đây khi deploy)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:4173,https://your-frontend.vercel.app"
