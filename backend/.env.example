PROJECT_NAME="IRS Mobile Admissions Platform API"
ENV=development
PORT=8000

# MongoDB Configuration
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="irs_admissions_db"

# JWT Security (Tạo bằng: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY="generate_random_64_character_hex_key_here"
JWT_SECRET_KEY="generate_random_64_character_hex_key_here"
ALGORITHM="HS256"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# External APIs
SERPAPI_KEY="your_serpapi_google_maps_key"
GOOGLE_MAPS_API_KEY=""

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
# Or single connection URL:
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# CORS Origin
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:4173"
